# 复制为 .env 后填写
DELI_MOBILE='你的手机号'
DELI_PASSWORD='你的原始登录密码'
# 首次运行可留空，login 会通过短信验证码获取并自动保存。
DELI_TRUST_CODE=''
# 可留空；首次登录时生成一次稳定 UUID 并自动保存。
DELI_TERMINAL_ID=''
# 组织ID, 只有一个组织可留空
DELI_ORG_ID=''
# dry -> 只检查|auto -> 按服务端当前动作提交|checkin -> 签到|checkout -> 退签
DELI_MODE='dry'
# 每次启动随机等待 0～该秒数；0 表示不延迟。
DELI_RANDOM_DELAY='0'

# QQ 邮箱推送；SMTP_PASSWORD 必须填写邮箱授权码，不是 QQ 密码。
# SMTP_SERVER 可填写主机或“主机:端口”；不填 SMTP_TO 时默认发给自己。
SMTP_SSL='true'
SMTP_EMAIL='你的QQ邮箱@qq.com'
SMTP_PASSWORD='你的QQ邮箱授权码'
SMTP_NAME='青龙脚本运行通知'
SMTP_SERVER='smtp.qq.com:465'
# SMTP_TO='接收通知的邮箱；可用逗号分隔多个地址'
